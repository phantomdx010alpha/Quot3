{
  "name": "quot3",
  "version": "0.1.11",
  "private": true,
  "productName": "Quot3",
  "author": "Quot3",
  "description": "Quot3 — local-first, keyboard-first desktop quotation app",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack": "electron-vite build && electron-builder --win --dir --publish never",
    "dist": "electron-vite build && electron-builder --win nsis --publish never",
    "release": "electron-vite build && electron-builder --win nsis --publish always",
    "check:signing": "node scripts/signing-env.mjs",
    "dist:signed": "node scripts/signing-env.mjs && electron-vite build && electron-builder --win nsis --publish never -c.forceCodeSigning=true",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.integration.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "perf:acceptance": "vitest run --config vitest.perf.config.ts",
    "test:e2e": "electron-vite build && playwright test",
    "test:e2e:xvfb": "xvfb-run -a --server-args=\"-screen 0 1366x768x24\" npm run test:e2e",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.6.1",
    "drizzle-kit": "0.31.11",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "30.1.2",
    "postcss": "8.5.29",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-virtual": "3.14.13",
    "better-sqlite3": "13.0.3",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.3",
    "electron-updater": "6.8.9",
    "exceljs": "4.4.0",
    "fuse.js": "7.5.0",
    "immer": "11.1.21",
    "pdf-to-printer": "5.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  }
}
