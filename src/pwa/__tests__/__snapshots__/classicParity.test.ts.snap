exports[`classic DOM parity (layout = classic, the only layout) > Settings page: Themes 1`] = `"<div class="q3-shell"><header class="q3-bar"><button class="q3-btn" aria-label="Back">Back</button><h1>Themes</h1></header><main class="q3-main"><div class="q3-settings"><section class="q3-set" aria-label="Themes"><h2 class="q3-h2">Themes</h2><p class="q3-muted">The same built-in themes as the Windows app. The choice is kept on this phone.</p><div class="q3-themes" role="group" aria-label="Theme"><button type="button" class="q3-theme" aria-pressed="true" aria-label="Navy Ember"><span class="q3-swatch" aria-hidden="true"><span style="background: rgb(15, 26, 46);"></span><span style="background: rgb(20, 35, 61);"></span><span style="background: rgb(255, 123, 123);"></span></span><span class="q3-theme-name">Navy Ember</span><span class="q3-muted q3-theme-mode">Dark</span></button><button type="button" class="q3-theme" aria-pressed="false" aria-label="Paper"><span class="q3-swatch" aria-hidden="true"><span style="background: rgb(233, 237, 244);"></span><span style="background: rgb(238, 242, 248);"></span><span style="background: rgb(186, 47, 47);"></span></span><span class="q3-theme-name">Paper</span><span class="q3-muted q3-theme-mode">Light</span></button><button type="button" class="q3-theme" aria-pressed="false" aria-label="Glossy Glass"><span class="q3-swatch" aria-hidden="true"><span style="background: rgb(11, 27, 31);"></span><span style="background: rgb(17, 39, 44);"></span><span style="background: rgb(255, 180, 84);"></span></span><span class="q3-theme-name">Glossy Glass</span><span class="q3-muted q3-theme-mode">Dark</span></button><button type="button" class="q3-theme" aria-pressed="false" aria-label="Space"><span class="q3-swatch" aria-hidden="true"><span style="background: rgb(6, 10, 20);"></span><span style="background: rgb(13, 20, 36);"></span><span style="background: rgb(63, 216, 255);"></span></span><span class="q3-theme-name">Space</span><span class="q3-muted q3-theme-mode">Dark</span></button><button type="button" class="q3-theme" aria-pressed="false" aria-label="Red and Navy Blue"><span class="q3-swatch" aria-hidden="true"><span style="background: rgb(10, 24, 48);"></span><span style="background: rgb(16, 38, 74);"></span><span style="background: rgb(255, 74, 94);"></span></span><span class="q3-theme-name">Red and Navy Blue</span><span class="q3-muted q3-theme-mode">Dark</span></button><button type="button" class="q3-theme" aria-pressed="false" aria-label="Red Deep-Black"><span class="q3-swatch" aria-hidden="true"><span style="background: rgb(5, 5, 5);"></span><span style="background: rgb(14, 12, 12);"></span><span style="background: rgb(255, 59, 59);"></span></span><span class="q3-theme-name">Red Deep-Black</span><span class="q3-muted q3-theme-mode">Dark</span></button><button type="button" class="q3-theme" aria-pressed="false" aria-label="Light (phone)"><span class="q3-swatch" aria-hidden="true"><span style="background: rgb(244, 246, 250);"></span><span style="background: rgb(255, 255, 255);"></span><span style="background: rgb(186, 47, 47);"></span></span><span class="q3-theme-name">Light (phone)</span><span class="q3-muted q3-theme-mode">Light</span></button></div></section><section class="q3-set" aria-label="Layout"><h2 class="q3-h2">Layout</h2><p class="q3-muted">Classic is today’s screen. Changing the layout never changes your bills.</p><div class="q3-chips" role="group" aria-label="Layout"><button type="button" class="q3-chip" aria-pressed="true">Classic</button><button type="button" class="q3-chip" aria-pressed="false">Tidy tabs</button><button type="button" class="q3-chip" aria-pressed="false">Guided flow</button><button type="button" class="q3-chip" aria-pressed="false">Bills inbox</button></div><p class="q3-muted">Today’s screen, exactly as it is now.</p></section></div></main><nav class="q3-nav" aria-label="Main"><button type="button" class="q3-nav-item"><svg xmlns="http://www.w3.org/2000/svg" width="22" 