exports[`classic DOM parity (layout = classic, the only layout) > Settings page: Storage and backup 1`] = `"<div class="q3-shell"><header class="q3-bar"><button class="q3-btn" aria-label="Back">Back</button><h1>Storage and backup</h1></header><main class="q3-main"><div class="q3-settings"><section class="q3-set" aria-label="Storage and backup"><h2 class="q3-h2">Storage and backup</h2><div class="q3-row"><span>Kept by the browser</span><span>unknown</span></div><div class="q3-row"><span>Used</span><span>unknown of unknown</span></div><div class="q3-row"><span>Last export</span><span>never</span></div><p class="q3-note q3-note-warn" role="status">This phone has bills but no backup file yet. Export one.</p><div class="q3-actions"><button type="button" class="q3-btn q3-btn-primary">Export backup</button><label class="q3-btn">Import backup<input aria-label="Import backup file" accept="application/json,.json" hidden="" type="file"></label></div><h2 class="q3-h2">Reset phone data</h2><p class="q3-muted">Erases the bills and customers on this phone only. Export a backup first.</p><button type="button" class="q3-btn">Reset phone data</button></section></div></main><nav class="q3-nav" aria-label="Main"><button type="button" class="q3-nav-item"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M217.9,110.1l-80-80a14,14,0,0,0-19.8,0l-80,80A13.92,13.92,0,0,0,34,120v96a6,6,0,0,0,6,6h64a6,6,0,0,0,6-6V158h36v58a6,6,0,0,0,6,6h64a6,6,0,0,0,6-6V120A13.92,13.92,0,0,0,217.9,110.1ZM210,210H158V152a6,6,0,0,0-6-6H104a6,6,0,0,0-6,6v58H46V120a2,2,0,0,1,.58-1.42l80-80a2,2,0,0,1,2.84,0l80,80A2,2,0,0,1,210,120Z"></path></svg><span>Home</span></button><button type="button" class="q3-nav-item"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M134,80v44.6l37.09,22.25a6,6,0,0,1-6.18,10.3l-40-24A6,6,0,0,1,122,128V80a6,6,0,0,1,12,0Zm-6-