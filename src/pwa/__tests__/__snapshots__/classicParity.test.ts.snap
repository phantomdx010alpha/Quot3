exports[`classic DOM parity (layout = classic, the only layout) > Settings page: App lock 1`] = `"<div class="q3-shell"><header class="q3-bar"><button class="q3-btn" aria-label="Back">Back</button><h1>App lock</h1></header><main class="q3-main"><div class="q3-settings"><section class="q3-set" aria-label="App lock"><h2 class="q3-h2">App lock</h2><div class="q3-row"><span>Status</span><span>Off</span></div><label class="q3-field"><span class="q3-muted">New PIN</span><input class="q3-input" aria-label="New PIN" inputmode="numeric" autocomplete="off" maxlength="8" type="password" value=""></label><label class="q3-field"><span class="q3-muted">Repeat PIN</span><input class="q3-input" aria-label="Repeat PIN" inputmode="numeric" autocomplete="off" maxlength="8" type="password" value=""></label><button type="button" class="q3-btn q3-btn-primary">Turn on app lock</button><p class="q3-muted">The lock keeps out someone who picks up your phone and opens the app. It does not encrypt your bills.</p></section></div></main><nav class="q3-nav" aria-label="Main"><button type="button" class="q3-nav-item"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M217.9,110.1l-80-80a14,14,0,0,0-19.8,0l-80,80A13.92,13.92,0,0,0,34,120v96a6,6,0,0,0,6,6h64a6,6,0,0,0,6-6V158h36v58a6,6,0,0,0,6,6h64a6,6,0,0,0,6-6V120A13.92,13.92,0,0,0,217.9,110.1ZM210,210H158V152a6,6,0,0,0-6-6H104a6,6,0,0,0-6,6v58H46V120a2,2,0,0,1,.58-1.42l80-80a2,2,0,0,1,2.84,0l80,80A2,2,0,0,1,210,120Z"></path></svg><span>Home</span></button><button type="button" class="q3-nav-item"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M134,80v44.6l37.09,22.25a6,6,0,0,1-6.18,10.3l-40-24A6,6,0,0,1,122,128V80a6,6,0,0,1,12,0Zm-6-46A93.4,93.4,0,0,0,61.51,61.56c-8.58,8.68-16,17-23.51,25.8V64a6,6,0,0,0-12,0v40a6,6,0,0,0,6,6H72a6,6,0,0,0,0-12H44.73C52.86,88.29,60.79,79.35,70,70a82,