exports[`classic DOM parity (layout = classic, the only layout) > Settings page: About Quot3 1`] = `"<div class="q3-shell"><header class="q3-bar"><button class="q3-btn" aria-label="Back">Back</button><h1>About Quot3</h1></header><main class="q3-main"><div class="q3-settings"><section class="q3-about" aria-label="About Quot3"><img class="q3-about-icon" alt="" width="96" height="96" src="/icons/icon-192.png"><h2 class="q3-about-name">Quot3</h2><p class="q3-about-version" data-testid="about-version">Version unknown</p><p class="q3-muted">Quotations, made fast. Local-first and keyboard-first.</p><div class="q3-row"><span>Publisher</span><span data-testid="about-publisher">Ankit Shukla</span></div><div class="q3-row"><span>Email</span><span data-testid="about-email">phantomdx9@gmail.com</span></div><div class="q3-actions"><button type="button" class="q3-btn">Copy email</button><a class="q3-btn" href="mailto:phantomdx9@gmail.com?subject=Quot3%20feedback">Write an email</a></div><h2 class="q3-h2">This phone</h2><div class="q3-row"><span>Persistent storage API</span><span>no</span></div><div class="q3-row"><span>Share files</span><span>no</span></div><div class="q3-row"><span>Single-writer lock</span><span>no</span></div><div class="q3-row"><span>Offline shell</span><span>no</span></div><div class="q3-row"><span>Installed or installable</span><span>no</span></div><p class="q3-muted">© 2026 Quot3. All rights reserved.</p></section></div></main><nav class="q3-nav" aria-label="Main"><button type="button" class="q3-nav-item"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M217.9,110.1l-80-80a14,14,0,0,0-19.8,0l-80,80A13.92,13.92,0,0,0,34,120v96a6,6,0,0,0,6,6h64a6,6,0,0,0,6-6V158h36v58a6,6,0,0,0,6,6h64a6,6,0,0,0,6-6V120A13.92,13.92,0,0,0,217.9,110.1ZM210,210H158V152a6,6,0,0,0-6-6H104a6,6,0,0,0-6,6v58H46V120a2,2,0,0,1,.58-1.42l80-80a2,2,0,0,1,2.84,0l80,80A2,2,0,0,1,210,120Z"></path></svg><span>Ho