exports[`classic DOM parity (layout = classic, the only layout) > Settings page: Branch and sync 1`] = `"<div class="q3-shell"><header class="q3-bar"><button class="q3-btn" aria-label="Back">Back</button><h1>Branch and sync</h1></header><main class="q3-main"><div class="q3-settings"><section class="q3-set" aria-label="Branch and sync"><h2 class="q3-h2">Branch and sync</h2><p class="q3-muted">Not linked. Sign in with a seat from your organisation to share bills with your other computers.</p><p class="q3-note">Sync sign-in is not available right now (the phone data could not be opened).</p><label class="q3-field"><span class="q3-muted">Supabase URL</span><input class="q3-input" aria-label="Supabase URL" disabled="" autocomplete="off" autocapitalize="off" spellcheck="false" type="text" value=""></label><label class="q3-field"><span class="q3-muted">Public (anon) key</span><input class="q3-input" aria-label="Public (anon) key" disabled="" autocomplete="off" autocapitalize="off" spellcheck="false" type="text" value=""></label><label class="q3-field"><span class="q3-muted">License key</span><input class="q3-input" aria-label="License key" disabled="" autocomplete="off" autocapitalize="off" spellcheck="false" type="text" value=""></label><label class="q3-field"><span class="q3-muted">Seat email</span><input class="q3-input" aria-label="Seat email" disabled="" autocomplete="off" autocapitalize="off" spellcheck="false" type="email" value=""></label><label class="q3-field"><span class="q3-muted">Seat password</span><input class="q3-input" aria-label="Seat password" disabled="" autocomplete="current-password" autocapitalize="off" spellcheck="false" type="password" value=""></label><label class="q3-field"><span class="q3-muted">Branch name for this phone</span><input class="q3-input" aria-label="Branch name for this phone" disabled="" autocomplete="off" autocapitalize="off" spellcheck="false" type="text" value=""></label><label class="q3-field"><span class="q3-muted">PO prefix</span><input class="q3-input" aria-label="PO prefix" disabled="" autocomplete="off" autocapitalize="off" spellcheck="false" type="text" value=""></label><button type="button" class="q3-btn q3-btn-primary" disabled="">Sign in</button></section></div></main><nav class="q3-nav" aria-label="Main"><button type="button" class="q3-nav-item"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M217.9,110.1l-80-80a14,14,0,0,0-19.8,0l-80,80A13.92,13.92,0,0,0,34,120v96a6,6,0,0,0,6,6h64a6,6,0,0,0,6-6V158h36v58a6,6,0,0,0,6,6h64a6,6,0,0,0,6-6V120A13.92,13.92,0,0,0,217.9,110.1ZM210,210H158V152a6,6,0,0,0-6-6H104a6,6,0,0,0-6,6v58H46V120a2,2,0,0,1,.58-1.42l80-80a2,2,0,0,1,2.84,0l80,80A2,2,0,0,1,210,120Z"></path></svg><span>Home</span></button><button type="button" class="q3-nav-item"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M134,80v44.6l37.09,22.25a6,6,0,0,1-6.18,10.3l-40-24A6,6,0,0,1,122,128V80a6,6,0,0,1,12,0Zm-6-46A93.4,93.4,0,0,0,61.51,61.56c-8.58,8.68-16,17-23.51,25.8V64a6,6,0,0,0-12,0v40a6,6,0,0,0,6,6H72a6,6,0,0,0,0-12H44.73C52.86,88.29,60.79,79.35,70,70a82,82,0,1,1,1.7,117.62,6,6,0,1,0-8.24,8.72A94,94,0,1,0,128,34Z"></path></svg><span>History</span></button><button type="button" class="q3-nav-item"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M128,26A102,102,0,1,0,230,128,102.12,102.12,0,0,0,128,26Zm0,192a90,90,0,1,1,90-90A90.1,90.1,0,0,1,128,218Zm46-90a6,6,0,0,1-6,6H134v34a6,6,0,0,1-12,0V134H88a6,6,0,0,1,0-12h34V88a6,6,0,0,1,12,0v34h34A6,6,0,0,1,174,128Z"></path></svg><span>New</span></button><button type="button" class="q3-nav-item"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M112.6,158.43a58,58,0,1,0-57.2,0A93.83,93.83,0,0,0,5.21,19