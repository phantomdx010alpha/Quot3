exports[`classic DOM parity (layout = classic, the only layout) > Settings list 1`] = `"<div class="q3-shell"><header class="q3-bar"><button class="q3-btn" aria-label="Back">Back</button><h1>Settings</h1></header><main class="q3-main"><div class="q3-settings"><ul class="q3-menu" aria-label="Settings"><li><button type="button" class="q3-menu-item"><span class="q3-menu-text"><span class="q3-menu-label">Themes</span><span class="q3-menu-hint">Navy Ember</span></span><span class="q3-menu-chev" aria-hidden="true">›</span></button></li><li><button type="button" class="q3-menu-item"><span class="q3-menu-text"><span class="q3-menu-label">Company</span><span class="q3-menu-hint">Name, phone, address and logo for Professional bills</span></span><span class="q3-menu-chev" aria-hidden="true">›</span></button></li><li><button type="button" class="q3-menu-item"><span class="q3-menu-text"><span class="q3-menu-label">Branch and sync</span><span class="q3-menu-hint">Sign in, PO prefix, share bills with your computers</span></span><span class="q3-menu-chev" aria-hidden="true">›</span></button></li><li><button type="button" class="q3-menu-item"><span class="q3-menu-text"><span class="q3-menu-label">Share defaults</span><span class="q3-menu-hint">Rough or Professional, image or PDF</span></span><span class="q3-menu-chev" aria-hidden="true">›</span></button></li><li><button type="button" class="q3-menu-item"><span class="q3-menu-text"><span class="q3-menu-label">Storage and backup</span><span class="q3-menu-hint">Export, import and reset this phone</span></span><span class="q3-menu-chev" aria-hidden="true">›</span></button></li><li><button type="button" class="q3-menu-item"><span class="q3-menu-text"><span class="q3-menu-label">App lock</span><span class="q3-menu-hint">PIN when the app opens</span></span><span class="q3-menu-chev" aria-hidden="true">›</span></button></li><li><button type="button" class="q3-menu-item"><span class="q3-menu-text"><span class="q3-menu-label">About Quot3</sp