exports[`classic DOM parity (layout = classic, the only layout) > Unsaved bill prompt 1`] = `"<div class="q3-shell"><header class="q3-bar"><button class="q3-btn" aria-label="Back">Back</button><h1>New bill</h1></header><main class="q3-main"><div class="q3-editor"><section class="q3-party" aria-label="Party"><div class="q3-party-name"><input class="q3-input" aria-label="Party name" placeholder="Party name" autocomplete="off" data-f="party:name" enterkeyhint="next" value="Zeta"><ul class="q3-suggest" role="listbox" aria-label="Customers"><li role="option" aria-selected="false"><button type="button" class="q3-li-btn"><span class="q3-li-title">Beta Stores</span><span class="q3-muted">9800000002</span></button></li></ul></div><div class="q3-party-line"><input class="q3-input" inputmode="tel" aria-label="Phone" placeholder="Phone" value=""><input class="q3-input" aria-label="Transport" placeholder="Transport" value=""><button type="button" class="q3-btn q3-icon-btn" aria-expanded="false" aria-label="Address"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,53.66,90.34L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z"></path></svg></button></div><p class="q3-note">New customer: it is added when you save.</p><div class="q3-chips" role="group" aria-label="Bill format"><button type="button" class="q3-chip" aria-pressed="true">Non-GST</button><button type="button" class="q3-chip" aria-pressed="false">GST</button></div></section><ol class="q3-rows" aria-label="Items"><li class="q3-erow"><button type="button" class="q3-erow-line" aria-label="Edit row"><span class="q3-sl"></span><span class="q3-ename"><span class="q3-muted">Item</span></span><span class="q3-eqty"></span><span class="q3-erate"></span><span class="q3-eamt"></span></button></li></ol><button type="button" class="q3-btn q3-add"><svg xmlns="http://www.w3.org/2000/svg" width="16" heig