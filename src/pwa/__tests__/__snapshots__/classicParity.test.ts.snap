exports[`classic DOM parity (layout = classic, the only layout) > Settings page: Company 1`] = `"<div class="q3-shell"><header class="q3-bar"><button class="q3-btn" aria-label="Back">Back</button><h1>Company</h1></header><main class="q3-main"><div class="q3-settings"><section class="q3-set" aria-label="Company"><h2 class="q3-h2">Company (for Professional bills)</h2><p class="q3-muted">This is kept on this phone only. It does not sync with your computers.</p><label class="q3-field"><span class="q3-muted">Company name</span><input class="q3-input" aria-label="Company name" autocomplete="off" value=""></label><label class="q3-field"><span class="q3-muted">Phone</span><input class="q3-input" aria-label="Company phone" inputmode="tel" autocomplete="off" type="tel" value=""></label><label class="q3-field"><span class="q3-muted">Address</span><input class="q3-input" aria-label="Company address" autocomplete="off" value=""></label><div class="q3-row"><span>Logo</span><span>none</span></div><div class="q3-actions"><button type="button" class="q3-btn">Choose logo</button><input aria-label="Logo file" accept="image/png,image/jpeg,image/webp" hidden="" type="file"></div><button type="button" class="q3-btn q3-btn-primary">Save company</button></section></div></main><nav class="q3-nav" aria-label="Main"><button type="button" class="q3-nav-item"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M217.9,110.1l-80-80a14,14,0,0,0-19.8,0l-80,80A13.92,13.92,0,0,0,34,120v96a6,6,0,0,0,6,6h64a6,6,0,0,0,6-6V158h36v58a6,6,0,0,0,6,6h64a6,6,0,0,0,6-6V120A13.92,13.92,0,0,0,217.9,110.1ZM210,210H158V152a6,6,0,0,0-6-6H104a6,6,0,0,0-6,6v58H46V120a2,2,0,0,1,.58-1.42l80-80a2,2,0,0,1,2.84,0l80,80A2,2,0,0,1,210,120Z"></path></svg><span>Home</span></button><button type="button" class="q3-nav-item"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><p